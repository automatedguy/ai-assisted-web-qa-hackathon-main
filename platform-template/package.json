{
  "name": "qa-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "dev": "node --env-file=../.env --import tsx --watch src/server.ts",
    "start": "node --import tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "QA_DISABLE_SCREENSHOTS=1 QA_DISABLE_BROWSER_CHECKS=1 node --import tsx --test test/*.test.ts",
    "test:activity-ui": "node test/activity-panel.browser.mjs",
    "test:catalog-browser": "node --import tsx test/catalog.browser.ts",
    "test:catalog-live": "node --env-file=../.env --import tsx test/catalog-live.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "cheerio": "^1.1.2",
    "express": "^5.1.0",
    "openai": "^5.12.2",
    "playwright": "^1.64.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
