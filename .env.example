OPENAI_API_KEY=replace_with_your_key
OPENAI_MODEL=gpt-6-astra
# Optional USD estimates per million tokens. Blank rates use the dated
# gpt-6-astra Standard short-context preset; other models need custom rates.
# If overriding, provide BOTH input and output. Omitted cache rates use input.
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
OPENAI_CACHED_INPUT_USD_PER_MILLION=
OPENAI_CACHE_WRITE_USD_PER_MILLION=
# Optional overrides (local defaults point to the supplied practice assets):
# These seed the app's selectors. Use Test configuration to save other site URLs
# and upload profiles with their reference folders without changing this file.
# SITE_URL=http://localhost:8080
# LINGUISTIC_ASSET_PATH=/absolute/path/to/profile.yaml
# ISSUE_SCHEMA_PATH=/absolute/path/to/ISSUE_SCHEMA.json
# REFERENCE_CONTENT_PATH=/absolute/path/to/reference-content
# SQLite history, uploaded profiles and screenshots (default: platform-template/data, gitignored).
# QA_DATA_DIR=/absolute/path/to/qa-history
# SCREENSHOT_DIR=/absolute/path/to/persistent/screenshots
# Browser checks use fresh, unauthenticated contexts and same-origin GET requests.
# QA_BROWSER_PATH=/absolute/path/to/chrome
# QA_MAX_STATES_PER_VIEWPORT=16
# QA_DISABLE_BROWSER_CHECKS=1
# QA_DISABLE_SCREENSHOTS=1
