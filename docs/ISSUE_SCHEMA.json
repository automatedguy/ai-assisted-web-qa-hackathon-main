{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QA Issue",
  "type": "object",
  "required": ["id", "category", "severity", "location", "description", "evidence", "confidence", "status"],
  "properties": {
    "id": { "type": "string" },
    "category": {
      "type": "string",
      "enum": [
        "spelling_grammar",
        "formatting",
        "links",
        "locale_rules",
        "brand_voice",
        "translation_quality",
        "terminology",
        "media"
      ]
    },
    "severity": {
      "type": "string",
      "enum": ["critical", "major", "minor", "suggestion"]
    },
    "location": {
      "type": "object",
      "required": ["page_url", "element_type"],
      "properties": {
        "page_url": { "type": "string" },
        "selector_or_xpath": { "type": "string" },
        "element_type": {
          "type": "string",
          "enum": ["text", "image", "video", "link"]
        }
      }
    },
    "visual_evidence": {
      "type": "object",
      "required": ["screenshot_url", "highlighted"],
      "properties": {
        "screenshot_url": { "type": "string" },
        "highlighted": { "type": "boolean" },
        "note": { "type": "string" }
      }
    },
    "description": { "type": "string" },
    "evidence": { "type": "string" },
    "expected": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "suggested_fix": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["new", "verified", "dismissed", "escalated"]
    }
  }
}
